{
  "name": "project-ahang-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "白狮阿杭计划 uni-app 用户端、独立管理后台与 Node.js/MySQL API",
  "scripts": {
    "dev": "concurrently -k -n api,uni,admin -c yellow,green,cyan \"npm:server:dev\" \"npm:dev:h5\" \"npm:dev:admin\"",
    "dev:h5": "uni",
    "dev:admin": "vite --config admin/vite.config.ts",
    "dev:mp-weixin": "uni -p mp-weixin",
    "server:dev": "tsx watch --env-file=.env.development server.ts",
    "build": "npm run build:h5 && npm run build:admin && npm run build:server",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:init": "tsx scripts/db-import.ts",
    "db:migrate-images": "tsx scripts/migrate-upload-images.ts",
    "start": "node dist/server.cjs",
    "typecheck": "vue-tsc --noEmit",
    "test:api": "tsx scripts/api-smoke.ts",
    "test:approved-edit": "tsx scripts/approved-content-edit-smoke.ts",
    "test:logs": "tsx scripts/logging-smoke.ts",
    "lint": "npm run typecheck",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020220260725001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020220260725001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020220260725001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020220260725001",
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020220260725001",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "5.2.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.12"
  }
}
